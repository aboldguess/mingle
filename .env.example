# Copy to .env for local development (npm run dev). Never commit real secrets.
DATABASE_URL=postgres://mingle:mingle@localhost:5432/mingle
APP_URL=http://localhost:5173
PORT=3000

# LiveKit: run `livekit-server --dev` locally (key devkey / secret secret),
# or use a LiveKit Cloud project (wss://<project>.livekit.cloud).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Stripe (optional; billing is disabled until these are set). Use test keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Behind a load balancer / reverse proxy
TRUST_PROXY=false
# Comma separated emails with platform-wide admin rights (reserved for the upcoming super-admin console)
PLATFORM_ADMIN_EMAILS=
